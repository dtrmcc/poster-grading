# =====================================================================
#  Poster Grading — environment settings
#  Copy to .env and replace every value that starts with __REPLACE_ME
#  .env is git-ignored. NEVER commit real keys.
# =====================================================================

# ---------- Together AI (receives DE-IDENTIFIED content only) ----------
TOGETHER_API_KEY=__REPLACE_ME__together_api_key__
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Model IDs: copy exact names from https://api.together.ai/models (names change over time).
# Candidates listed by Together as supporting structured outputs (checked Oct 2026):
#   text:   deepseek-ai/DeepSeek-V4-Pro-0813   (strong; ~US$0.01 per student)
#           zai-org/GLM-5.3                    (strong)
#           openai/gpt-oss-120b                (cheaper)
#   vision: MiniMaxAI/MiniMax-M3               (needed later for poster-design review)
TOGETHER_MODEL_TEXT=__REPLACE_ME__text_model_id__
TOGETHER_MODEL_VISION=__REPLACE_ME__vision_model_id__

# ---------- Local model (Ollama on the Mac, OpenAI-compatible) ----------
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=__REPLACE_ME__local_model_name__
LOCAL_LLM_MODEL_VISION=__REPLACE_ME__local_vision_model_name__

# ---------- Which provider runs each AI task: local | together | off ----------
AI_TASK_DEIDENTIFY_CHECK=local
AI_TASK_REFERENCE_EXTRACT=local
AI_TASK_GRADE_SUGGEST=together
AI_TASK_DESIGN_REVIEW=together
AI_TASK_FEEDBACK_WRITE=together

# Show every outbound payload for approval before sending (recommended: true)
REQUIRE_SEND_CONFIRMATION=true

# ---------- Reference checking (Crossref "polite pool" contact email) ----------
CROSSREF_MAILTO=__REPLACE_ME__your_email__

# ---------- Backblaze B2 (encrypted backups, stage 4) ----------
B2_KEY_ID=__REPLACE_ME__b2_key_id__
B2_APPLICATION_KEY=__REPLACE_ME__b2_application_key__
B2_BUCKET=__REPLACE_ME__b2_bucket_name__
B2_ENDPOINT=__REPLACE_ME__b2_s3_endpoint__
